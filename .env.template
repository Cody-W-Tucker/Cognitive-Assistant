# ─── LLM Provider Keys ────────────────────────────────────────────────────────
# Provider requirements and model settings: docs/Getting-Started.md#model-configuration-bootstrap-stages

# OpenAI (GPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# ─── Provider Model Overrides (optional) ─────────────────────────────────────
# Set to override the default model for a provider.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MAX_OUTPUT=128_000

XAI_MODEL=grok-4.5
XAI_MAX_OUTPUT=128_000

ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_OUTPUT=128_000


