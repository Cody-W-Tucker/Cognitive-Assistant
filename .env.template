# ─── LLM Provider Keys ────────────────────────────────────────────────────────
# Uncomment and set ONLY the key for the provider you intend to use.
# The default provider is Anthropic (see lib/config.py DEFAULT_PROVIDER).

# OpenAI (GPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# ─── Provider Model Overrides (optional) ─────────────────────────────────────
# Uncomment and set to override the default model for a provider.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_CONTEXT_WINDOW=1_050_000
OPENAI_MAX_OUTPUT=128_000

XAI_MODEL=grok-4.5
XAI_CONTEXT_WINDOW=500_000
XAI_MAX_OUTPUT=128_000

ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_CONTEXT_WINDOW=1_000_000
ANTHROPIC_MAX_OUTPUT=128_000


